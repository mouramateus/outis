#!/bin/bash
# Grava o log do bootstrap (ou não) e fica no ar como um tor de verdade.
while [ $# -gt 0 ]; do [ "$1" = -f ] && C="$2"; shift; done
# Como o tor real: na opção Log o caminho é literal, aspas não são removidas.
L="$(sed -n 's/^Log notice file //p' "$C")"
printf '%s\n' "${FAKE_TOR_LOG-Bootstrapped 100% (done)}" > "$L"
sleep 30 & S=$!; trap "kill $S" TERM; wait $S
